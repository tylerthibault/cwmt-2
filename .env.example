# Environment variables for CWMT application
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# -----------------------------------------------------------------------
# Security — PII Encryption (REQUIRED)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------
FIELD_ENCRYPTION_KEY=change-me-to-a-strong-random-secret
SEARCH_HASH_KEY=change-me-to-a-different-strong-random-secret

# Flask session signing key (REQUIRED)
SECRET_KEY=change-me-to-yet-another-strong-random-secret

# -----------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------
FLASK_CONFIG=development

# -----------------------------------------------------------------------
# Database (optional — defaults to SQLite in instance/)
# -----------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost/cwmt

# -----------------------------------------------------------------------
# Rate limiting storage (optional — defaults to in-memory)
# Use Redis in production when running multiple workers:
# -----------------------------------------------------------------------
# RATELIMIT_STORAGE_URL=redis://localhost:6379/0
